NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=    # server only, never to the client
SUPABASE_DB_PASSWORD=         # server/CLI only

# "Solicitar informes" button on the artwork page (digits only for WhatsApp, with country code, e.g. 524771234567)
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Public URL of the deployed site (used in the e-mail confirmation link), e.g. https://kons.vercel.app
NEXT_PUBLIC_SITE_URL=
